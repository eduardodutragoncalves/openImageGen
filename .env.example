# Copy to .env and adjust. Every variable is optional: with an empty .env the
# service detects the GPUs it can see and places the models accordingly.
# All settings use the OIG_ prefix.

# ---------------------------------------------------------------- model
# 4-bit build of FLUX.2 [dev], the one that fits on consumer cards.
# Alternatives: black-forest-labs/FLUX.2-dev (bf16, needs a very large GPU),
# black-forest-labs/FLUX.2-klein-4B (Apache-2.0, small and fast).
OIG_REPO_ID=diffusers/FLUX.2-dev-bnb-4bit

# ------------------------------------------------------------- placement
# Auto-detected at startup. Uncomment only to override the heuristics, e.g. to
# pin components to particular cards or to force offloading.
# OIG_TRANSFORMER_DEVICE=cuda:0
# OIG_TEXT_ENCODER_DEVICE=cuda:1
# OIG_CPU_OFFLOAD=false
# Approximate footprints used by the planner, in GB. Set these when running a
# checkpoint it does not recognise.
# OIG_TRANSFORMER_VRAM_GB=19
# OIG_TEXT_ENCODER_VRAM_GB=16

# ------------------------------------------------------------- inference
OIG_DEFAULT_STEPS=50
OIG_DEFAULT_GUIDANCE=4.0
OIG_DEFAULT_WIDTH=1024
OIG_DEFAULT_HEIGHT=1024
# Output size cap. Derived from the VRAM left after the weights load; set it
# explicitly to override.
# OIG_MAX_PIXELS=1048576
OIG_MAX_REFERENCE_IMAGES=4

# ------------------------------------------------------------------ jobs
OIG_QUEUE_MAX_SIZE=32
OIG_JOB_TTL_SECONDS=3600
# Generations run one at a time; see the README before raising this.
OIG_WORKERS=1

# ---------------------------------------------------------------- safety
OIG_ENABLE_NSFW_FILTER=true
OIG_NSFW_THRESHOLD=0.85
# Copyright / public-figure screening through the text encoder. Free in VRAM
# terms, adds a second or so per request.
OIG_ENABLE_INTEGRITY_FILTER=true

# ----------------------------------------------------------- web models
# Remote providers. Every one of them is optional, and a key set in the
# studio is stored server-side and wins over anything here.

# openrouter
# One key covers both uses: upsample_prompt="openrouter", and generating
# through a model pinned on the Web models tab. "local" upsampling uses the
# text encoder that is already loaded and needs nothing here.
# OIG_OPENROUTER_API_KEY=sk-or-...

# The default model for prompt rewriting; a request may name another.
OIG_OPENROUTER_MODEL=mistralai/pixtral-large-2411

# runware
# A GPU marketplace: FLUX, SDXL, Qwen and a mirror of civitai, generated
# through its own API rather than on your cards. Unlike OpenRouter's, its
# catalog cannot be read at all without a key.
# OIG_RUNWARE_API_KEY=...

# ------------------------------------------------------------------- api
OIG_HOST=0.0.0.0
OIG_PORT=8000

# ⚠ REQUIRED when OIG_HOST is not 127.0.0.1.
# Comma-separated. The service refuses to start on a public interface with this
# empty, because that would leave generation open to anyone who can reach the
# port. Give each person their own key: the studio scopes history per key, so
# one key per person is what keeps their archives separate.
# OIG_API_KEYS=key-one,key-two
#
# Set this only when something in front of the service (a reverse proxy, a
# tunnel like Cloudflare Access or Tailscale) already authenticates callers.
# OIG_ALLOW_OPEN_ACCESS=false

# Where the job archive lives. It is a SQLite file; history survives restarts.
# OIG_STATE_DIR=./state

# Serve the built studio from app/static (build it with: cd frontend && npm run build).
# OIG_SERVE_UI=true
# Allow the Vite dev server origin. Development only; the built UI is same-origin.
# OIG_DEV=false
# OIG_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------- retention
# Generated files outlive the job record, so without a cap the archive fills
# the disk. Enforced after every write, oldest first.
OIG_OUTPUT_MAX_GB=50
# Also drop anything older than this, whatever the size. Unset means no age cap.
# OIG_OUTPUT_MAX_AGE_DAYS=90

# Exercise the HTTP layer without loading any model or touching a GPU.
OIG_DRY_RUN=false
# Seconds per simulated step under OIG_DRY_RUN. Non-zero so a dry run exercises
# progress, queue position and the ETA the way a real run does.
# OIG_DRY_RUN_STEP_SECONDS=0.08

# ------------------------------------------------------- huggingface auth
# black-forest-labs repos are gated; the 4-bit mirror is not, but a token is
# still recommended for rate limits.
# HF_TOKEN=hf_...
# Move the large weight cache off the system disk if needed:
# HF_HOME=/path/to/cache
